{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x86-no_asm-release",
      "displayName": "x86 (Pure C)",
      "description": "x86 with pure C implementation",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/x86-no_asm",
      "toolchainFile": "${sourceDir}/toolchains/x86_64-linux-gcc.cmake",
      "cacheVariables": {
        "USE_ASM": "OFF",
        "BUILD_TESTS": "ON",
        "BUILD_EMBEDDED": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "armv7-no_asm-release",
      "displayName": "ARMv7 (Pure C)",
      "description": "ARMv7 with pure C implementation",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/armv7-no_asm",
      "toolchainFile": "${sourceDir}/toolchains/armv7-none-eabi-gcc.cmake",
      "cacheVariables": {
        "USE_ASM": "OFF",
        "BUILD_TESTS": "OFF",
        "BUILD_EMBEDDED": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "armv7-asm-release",
      "displayName": "ARMv7 (ASM Optimized)",
      "description": "ARMv7 with assembly optimization",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/armv7-asm",
      "toolchainFile": "${sourceDir}/toolchains/armv7-none-eabi-gcc.cmake",
      "cacheVariables": {
        "USE_ASM": "ON",
        "BUILD_TESTS": "OFF",
        "BUILD_EMBEDDED": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x86-no_asm-release",
      "configurePreset": "x86-no_asm-release",
      "configuration": "Release"
    },
    {
      "name": "armv7-no_asm-release",
      "configurePreset": "armv7-no_asm-release",
      "configuration": "Release"
    },
    {
      "name": "armv7-asm-release",
      "configurePreset": "armv7-asm-release",
      "configuration": "Release"
    }
  ]
}